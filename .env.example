[TEMPLATE]
# ============================================================
# CityPulse environment template (Phases 1-4)
# Copy to .env and fill in your own values:  copy .env.example .env
# NEVER commit the real .env file (it is git-ignored).
# ============================================================

# Flask
FLASK_DEBUG=1
PORT=5000

# Comma-separated origins allowed to call the API directly (Vite dev server).
# The Vite dev server also proxies /api to Flask, so this is a convenience.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase PostgreSQL (backend only — never expose to the browser) ---
# PREFERRED (works on IPv4-only networks like campus/office Wi-Fi):
# Session pooler string from Supabase -> Connect -> Session pooler.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# ALTERNATIVE (direct, requires IPv6 network support):
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Public identifiers (safe to share, but keep them here rather than in JS).
# Get these from Supabase -> Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Leave DATABASE_URL empty (or delete the line) to run CityPulse in demo mode
# with clearly-labeled synthetic data.

# --- Phase 2: data providers (all optional; each falls back to labeled demo data) ---

# OpenAQ v3 air quality: free key at https://explore.openaq.org (account -> API keys).
# Sent as the X-API-Key header from the backend only. Rate-limited on the free tier.
OPENAQ_API_KEY=

# Open-Meteo weather is keyless (https://open-meteo.com/en/docs) and enabled by default.
# Set to 0 to force the labeled synthetic weather provider.
WEATHER_ENABLED=1

# Transit: a public GTFS-Realtime VehiclePositions feed URL (protobuf), if your city
# publishes one (see https://gtfs.org/realtime/ and the agency's license terms).
# Without it, CityPulse uses a clearly-labeled synthetic transit provider.
TRANSIT_GTFS_RT_URL=

# Civic incidents: a Socrata-style open-data resource URL returning JSON, plus a JSON
# object mapping our field names to the dataset's column names, e.g.
#   {"latitude":"latitude","longitude":"longitude","description":"category",...}
# Without it, CityPulse uses clearly-labeled synthetic incidents.
INCIDENTS_SOCRATA_URL=
INCIDENTS_FIELD_MAP=

# Ingestion safety
INGEST_COOLDOWN_SECONDS=120
# Optional shared secret: when set, POST /api/refresh requires header X-Refresh-Token.
REFRESH_TOKEN=

# --- Phase 3: AI summaries (optional; deterministic grounded fallback used when unset) ---
# Any OpenAI-compatible chat-completions endpoint works (provider configured server-side).
# Example (Groq free tier — verify current models/quotas yourself):
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.1-8b-instant
#   AI_API_KEY=your-key
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# --- Phase 3: anomaly detection tuning (explainable robust z-score) ---
ANOMALY_Z_THRESHOLD=3.5
ANOMALY_SEVERE_Z_THRESHOLD=6.0

# --- Phase 4: threshold-based alert rules (optional) ---
# JSON list of rules evaluated against stored observations; each becomes a
# deduplicated alert when an hourly bucket crosses the threshold. Rules are
# stored in the alert_rules table (UNIQUE on city/metric/operator/threshold),
# so this env is only a seed and re-running is idempotent. NULL values never
# trigger rules. Leave empty to use anomaly-derived alerts only. Example:
#   [{"city":"bengaluru","metric":"pm25_ugm3","operator":">","threshold_value":90,"window_hours":24,"label":"PM2.5 above 90"}]
ALERT_RULES_JSON=
